{
    "name": "magebitcom/module-documentation",
    "description": "Module documentation viewer for the Magento 2 admin panel",
    "type": "magento2-module",
    "license": "MIT",
    "authors": [
        {
            "name": "Magebit",
            "email": "info@magebit.com",
            "homepage": "https://magebit.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "magento/framework": "^103.0",
        "league/commonmark": "^2.10",
        "symfony/yaml": "^5.4 || ^6.0 || ^7.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Magebit\\Documentation\\": ""
        },
        "exclude-from-classmap": [
            "Test/"
        ]
    },
    "archive": {
        "exclude": [
            "/docs/plan",
            "/Test",
            "/.github",
            "/cliff.toml"
        ]
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
