<?php
/**
 * @var \Magento\Backend\Block\Template $block
 * @var \Magebit\Documentation\ViewModel\Sidebar $viewModel
 * @var \Magento\Framework\Escaper $escaper
 */
$viewModel = $block->getData('view_model');
$tree = $viewModel->getDocumentationTree();
?>
<div class="documentation-sidebar">
    <div class="doc-search">
        <input type="text"
               id="doc-search-input"
               class="doc-search-input"
               placeholder="<?= $escaper->escapeHtmlAttr(__('Search documentation...')) ?>"
               autocomplete="off" />
        <span class="doc-search-icon"></span>
        <span class="doc-search-spinner"></span>
        <button type="button" class="doc-search-clear" title="<?= $escaper->escapeHtmlAttr(__('Clear')) ?>"></button>
    </div>
    <div class="doc-search-results" style="display: none;"></div>
    <div class="doc-sidebar-header">
        <button type="button" class="doc-expand-all" data-expand-all title="<?= $escaper->escapeHtmlAttr(__('Expand All')) ?>">
            <span class="expand-all-icon"></span>
            <span class="expand-all-text"><?= $escaper->escapeHtml(__('Expand All')) ?></span>
        </button>
    </div>
    <div class="doc-tree">
        <?php if (empty($tree)): ?>
            <p class="no-documentation"><?= $escaper->escapeHtml(__('No documentation modules found.')) ?></p>
        <?php else: ?>
            <?php foreach ($tree as $moduleName => $moduleData): ?>
                <?php
                $moduleTitle = $moduleData['_title'] ?? $moduleName;
                $moduleIcon = $moduleData['_icon'] ?? null;
                $features = array_filter($moduleData, fn($key) => !str_starts_with($key, '_'), ARRAY_FILTER_USE_KEY);
                if (empty($features)) {
                    continue;
                }
                ?>
                <div class="doc-module" data-search-module="<?= $escaper->escapeHtmlAttr(strtolower($moduleTitle)) ?>" data-module-id="<?= $escaper->escapeHtmlAttr($moduleName) ?>">
                    <div class="doc-module-header collapsed" data-collapse-toggle>
                        <div class="doc-module-header-content">
                            <span class="collapse-icon"></span>
                            <?php if ($moduleIcon): ?>
                                <?php if (str_ends_with($moduleIcon, '.svg')): ?>
                                    <img src="<?= $escaper->escapeUrl($block->getViewFileUrl($moduleIcon)) ?>"
                                         alt=""
                                         class="doc-module-icon" />
                                <?php else: ?>
                                    <img src="<?= $escaper->escapeUrl($block->getViewFileUrl($moduleIcon)) ?>"
                                         alt=""
                                         class="doc-module-icon" />
                                <?php endif; ?>
                            <?php endif; ?>
                            <span class="doc-module-name"><?= $escaper->escapeHtml($moduleTitle) ?></span>
                        </div>
                        <button type="button" class="doc-module-expand" data-module-expand title="<?= $escaper->escapeHtmlAttr(__('Expand Module')) ?>">
                            <span class="module-expand-icon"></span>
                        </button>
                    </div>
                    <div class="doc-module-content collapsible-content">
                        <?php if (isset($moduleData['_changelog'])): ?>
                            <?php $changelog = $moduleData['_changelog']; ?>
                            <?php if (isset($changelog['file']) && $changelog['file']): ?>
                                <div class="doc-changelog" data-search-changelog="changelog">
                                    <a href="<?= $escaper->escapeUrl($viewModel->getDocUrl($moduleName, '_changelog', $changelog['file'])) ?>"
                                       class="doc-changelog-link <?= $viewModel->isActive($moduleName, '_changelog', $changelog['file']) ? 'active' : '' ?>">
                                        <span class="doc-changelog-icon"></span>
                                        <span class="doc-changelog-name"><?= $escaper->escapeHtml(__('Changelog')) ?></span>
                                    </a>
                                </div>
                            <?php endif; ?>
                        <?php endif; ?>
                        <?php foreach ($features as $featureName => $feature): ?>
                            <div class="doc-feature" data-search-feature="<?= $escaper->escapeHtmlAttr(strtolower($featureName)) ?>">
                                <div class="doc-feature-header collapsed" data-collapse-toggle>
                                    <span class="collapse-icon"></span>
                                    <span class="doc-feature-name"><?= $escaper->escapeHtml($featureName) ?></span>
                                </div>
                                <div class="doc-feature-content collapsible-content">
                                    <?= $block->getLayout()
                                        ->createBlock(\Magento\Backend\Block\Template::class)
                                        ->setTemplate('Magebit_Documentation::documentation/sidebar/structure.phtml')
                                        ->setData('structure', $feature['structure'])
                                        ->setData('module', $moduleName)
                                        ->setData('feature', $featureName)
                                        ->setData('prefix', '')
                                        ->setData('sidebar_view_model', $viewModel)
                                        ->toHtml() ?>
                                </div>
                            </div>
                        <?php endforeach; ?>
                    </div>
                </div>
            <?php endforeach; ?>
        <?php endif; ?>
        <p class="no-search-results" style="display: none;"><?= $escaper->escapeHtml(__('No results found.')) ?></p>
    </div>
</div>
